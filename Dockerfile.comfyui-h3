# ComfyUI image for MiniMax-H3 on RTX PRO 6000 Blackwell (SM120).
# Built from THIS fork's source (pins ComfyUI to the fork commit). Maintained prebuilts
# (ai-dock) are stale (Nov 2024: ComfyUI 0.2.x / torch cu121) and can't compute on sm_120.
# CUDA 12.8 base + torch cu128 (Blackwell kernels). Models mount from a PVC at runtime.
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-dev git ffmpeg libgl1 libglib2.0-0 \
      ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --upgrade pip

# Blackwell-capable torch FIRST so ComfyUI's requirements don't pull a non-cu128 build.
RUN pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu128

# ComfyUI source from this fork (H3 support is in core).
COPY . /opt/ComfyUI
RUN cd /opt/ComfyUI \
    && pip3 install -r requirements.txt \
    && pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu128

WORKDIR /opt/ComfyUI
EXPOSE 8188
# Serve flags come from the Deployment `args`.
ENTRYPOINT ["python3", "main.py"]
